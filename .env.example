# Google Apps Script Web App URL (Deploy → Web app → URL ending in /exec)
NEXT_PUBLIC_GOOGLE_SCRIPT_URL=

# ---------- Admin dashboard (server-side only - never prefix with NEXT_PUBLIC_) ----------
# Admin sign-in username
ADMIN_USERNAME=admin
# Password hash - generate with: npm run hash-password
ADMIN_PASSWORD_HASH=
# Random secret (at least 32 characters) used to sign the admin session cookie.
# npm run hash-password also prints one.
SESSION_SECRET=
# Must equal the ADMIN_KEY Script Property in the Google Apps Script (at least 32 characters)
ADMIN_API_KEY=
